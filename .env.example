# ── Server ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Auth ────────────────────────────────────────────────────────
# API keys for MCP client authentication (comma-separated)
MCP_API_KEYS=your-secret-api-key-here

# Session secret — at least 32 characters (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# AES-256-GCM key for database field encryption (API keys, tokens, secrets)
# Generate with: openssl rand -hex 32  |  store it as a Secret in Kubernetes!
DB_ENCRYPTION_KEY=CHANGE_ME_DB_ENCRYPTION_KEY

# Key rotation (set only during an active rotation, remove afterwards):
# 1. OLD_DB_ENCRYPTION_KEY = current key
# 2. DB_ENCRYPTION_KEY = new key
# 3. call POST /api/admin/encryption/rotate
# 4. remove OLD_DB_ENCRYPTION_KEY
# OLD_DB_ENCRYPTION_KEY=

# Session lifetime in hours (default: 24)
SESSION_MAX_AGE_HOURS=24

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_ENABLED=true
# Host `localhost` is for running the server on the host via `npm run dev`.
# For `docker compose up` this value is IGNORED — the mcp-server container
# derives its own URL against the `postgres` service (see docker-compose.yml).
POSTGRES_CONNECTION_URL=postgresql://aiops:CHANGE_ME@localhost:5432/aiops

# For the docker-compose postgres service:
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=CHANGE_ME

# ── Kubernetes ──────────────────────────────────────────────────
K8S_ENABLED=true
# Lokales Docker Desktop K8s:
KUBERNETES_SERVICE_HOST=host.docker.internal
KUBERNETES_SERVICE_PORT=6443
# In-cluster (e.g. AKS): KUBERNETES_SERVICE_HOST is set automatically — leave empty

# ── Grafana ─────────────────────────────────────────────────────
GRAFANA_ENABLED=false
GRAFANA_URL=http://localhost:3200
GRAFANA_API_KEY=glsa_xxxxxxxxxxxxxxxxxxxx

# ── OpenSearch ──────────────────────────────────────────────────
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME

# ── Limits ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
MAX_RESULT_ROWS=500
MAX_RESULT_SIZE_BYTES=524288

# ── Dynamic Tools Hot-Reload ─────────────────────────────────────
# Poll-Intervall in Sekunden (0 = deaktiviert)
DYNAMIC_TOOLS_POLL_INTERVAL_SEC=30

# ── Audit Log Retention ──────────────────────────────────────────
# How many days audit log entries are kept (default: 90)
# Consider 365 days if your retention policy requires it
AUDIT_LOG_RETENTION_DAYS=90

# ── OpenTelemetry Tracing + Metrics (optional) ───────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=argus-core

# ── Entra ID SSO (optional) ──────────────────────────────────────
# Keep false until everything is configured in Entra ID!
# Setup-Anleitung: docs/entra-sso-setup.md
ENTRA_SSO_ENABLED=false
# ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_SECRET=your-client-secret-value
# ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback

# AD group → Argus role mapping (Azure group object IDs)
# Roles: platform_admin | operations_admin | developer | agent_operator | viewer | chat_user
# Format: <group-object-id>:<role>,<group-object-id>:<role>,...
# ENTRA_GROUP_MAP=aaa-bbb-111:platform_admin,aaa-bbb-222:operations_admin,aaa-bbb-333:developer,aaa-bbb-444:agent_operator

# Default role for users without a matching group
ENTRA_DEFAULT_ROLE=viewer

# Emergency: local admins keep working when the IdP is down (keep true!)
ENTRA_EMERGENCY_LOCAL_ADMIN=true

# SSO-only mode: disable local login entirely (only once SSO is stable)
# ENTRA_DISABLE_LOCAL_LOGIN=false

# ── Generic OIDC SSO (optional, mutually exclusive with ENTRA_SSO_ENABLED) ──
# Works with Keycloak, Authentik, Okta and compatible workforce IdPs.
# Setup: docs/oidc-sso-setup.md
OIDC_SSO_ENABLED=false
# OIDC_PROVIDER_NAME=Keycloak
# OIDC_ACCOUNT_MANAGEMENT_URL=https://identity.example.com/realms/argus/account/#/account-security/signing-in
# OIDC_ADMIN_CONSOLE_URL=https://identity.example.com/admin/master/console/#/argus
# OIDC_AUTHORIZATION_URL=https://identity.example.com/realms/argus/protocol/openid-connect/auth
# OIDC_TOKEN_URL=https://identity.example.com/realms/argus/protocol/openid-connect/token
# OIDC_ISSUER=https://identity.example.com/realms/argus
# OIDC_JWKS_URI=https://identity.example.com/realms/argus/protocol/openid-connect/certs
# OIDC_CLIENT_ID=argus
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=https://argus.example.com/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_SUBJECT_CLAIM=sub
# OIDC_EMAIL_CLAIM=email
# OIDC_DISPLAY_NAME_CLAIM=name
# OIDC_GROUPS_CLAIM=groups
# OIDC_GROUP_MAP=argus-admins:platform_admin,argus-developers:developer
# Signed ID-token assurance accepted for sensitive-operation MFA step-up.
# Keep these aligned with the IdP. Values not explicitly listed fail closed.
# OIDC_MFA_AMR_VALUES=mfa,otp,hwk,webauthn,fido
# OIDC_MFA_ACR_VALUES=urn:example:loa:2,urn:example:loa:3
# OIDC_MFA_MAX_AGE_SECONDS=600
# Premium: federate the same workforce identity into human-facing backend UIs.
# Workflow/service credentials remain available when this feature stays off.
# ARGUS_BACKEND_SSO_ENABLED=false
# ARGUS_BACKEND_SSO_ALLOWED_ORIGINS=https://git.example.com,https://grafana.example.com

# ── Solution Pack containers (optional) ─────────────────────────────
# Operator-controlled internal endpoints. Plain HTTP is accepted only for
# loopback, private IPs and Compose/Kubernetes service names.
# ARGUS_SOLUTION_PACK_ENDPOINTS=argus.dev=http://argus-dev:8080,argus.aiops=http://argus-aiops:8080,argus.hermes=http://argus-hermes:2040
# Optional per-pack Bearer credentials loaded from mounted secret files.
# ARGUS_SOLUTION_PACK_TOKEN_FILES=argus.dev=/run/secrets/argus-dev-token,argus.aiops=/run/secrets/argus-aiops-token,argus.hermes=/run/secrets/argus-hermes-discovery-token
# ARGUS_CORE_VERSION=1.0.0
# ARGUS_SOLUTION_PACK_DISCOVERY_TIMEOUT_MS=5000
# ARGUS_SOLUTION_PACK_REFRESH_SEC=60
# Managed external runtimes remain disabled unless both settings below are
# deliberately configured. Use the network-visible Core origin seen by the
# per-run MCP auth proxy (never derive this from a browser Host header).
# V1 permits only explicitly reviewed read-only bundle IDs; remote MCP tool
# metadata is not yet sufficient to infer write safety automatically.
# ARGUS_RUNTIME_MCP_ORIGIN=http://mcp-server:3000
# ARGUS_MANAGED_RUNTIME_READ_ONLY_BUNDLE_IDS=3,7
# Local images/ports used by compose.external-pack.yml.
# External Hermes requires a Docker secret *source file*. The Compose overlay
# mounts it only in mcp-server and argus-hermes as
# /run/secrets/argus-hermes-discovery-token; do not put its token value here.
# ARGUS_HERMES_DISCOVERY_TOKEN_FILE=./secrets/argus-hermes-discovery-token
# ARGUS_HERMES_IMAGE=argus-hermes:local
# ARGUS_HERMES_PORT=2040
# To attach an existing Hermes HTTP service, also use
# compose.hermes-attached.yml. The API key stays in a Docker secret source
# file and is mounted only into argus-hermes.
# HERMES_BASE_URL=http://host.docker.internal:8000
# ARGUS_HERMES_API_KEY_SOURCE_FILE=./secrets/hermes-api-key
# For a local provider-neutral Hermes service (no LiteLLM), add
# compose.hermes-local.yml. Provider OAuth/model state remains exclusively in
# the persistent Hermes volume. The bootstrap pins the official release and
# disables native API tools by default for the attached certification profile.
# HERMES_UPSTREAM_IMAGE=nousresearch/hermes-agent:v2026.7.7.2
# HERMES_UPSTREAM_PORT=8642
# HERMES_DASHBOARD_PORT=9119
# HERMES_API_SERVER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HERMES_UPSTREAM_MODEL_NAME=hermes-agent
# If setting the complete ARGUS_SOLUTION_PACK_TOKEN_FILES map above, retain
# argus.hermes=/run/secrets/argus-hermes-discovery-token exactly once.
# ARGUS_DEV_IMAGE=argus-dev:local
# ARGUS_DEV_PORT=2026
# Core-owned, token-free Dev Git candidate. Promote Core/Dev/Workspace together;
# review the Dev Git broker settings before enabling or rebuilding Dev.
ARGUS_DEV_GIT_BROKER_ENABLED=false
# ARGUS_AIOPS_IMAGE=argus-aiops:local
# ARGUS_AIOPS_PORT=2030
# ARGUS_AIOPS_A2A_PUBLIC_URL=http://argus-aiops:2030
# ARGUS_AIOPS_AGENT_TIMEOUT_MS=900000
# Connector evidence is accepted for five days, warns for the final two days,
# and is enforced at the Core-issued Argus AIOps execution-grant boundary.
# KUBERNETES_CERTIFICATION_WARNING_AGE_HOURS=120
# KUBERNETES_CERTIFICATION_MAX_AGE_HOURS=168
# KUBERNETES_CERTIFICATION_ENFORCE_AIOPS=true
# Maximum number of automatic native-alert investigations that may run at once.
# Every dispatch still requires an explicitly configured bundle and certified target.
# NATIVE_ALERT_AIOPS_MAX_CONCURRENT=3
# Shared HMAC-SHA256 secret for POST
# /api/observability/aiops/provider-signals/:provider. Generate a dedicated
# high-entropy value; never reuse a provider API credential.
# AIOPS_PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# AIOPS_POST_CHANGE_MONITOR_DELAY_SEC=300
# AIOPS_POST_CHANGE_MONITOR_POLL_SEC=30
# In-progress execution/check/rollback claims older than this are reconciled
# through the exact approved read-only verification call. No new write is issued.
# AIOPS_REMEDIATION_RECONCILE_STALE_SEC=120
# Optional dedicated scrape key. Defaults to the first MCP_API_KEYS entry in
# the local AIOps demo overlay and is never written to the repository.
# ARGUS_PROMETHEUS_API_KEY=
# ARGUS_PROMETHEUS_PORT=9090
# If ARGUS_EGRESS_ALLOWLIST is non-empty, include `prometheus` when running the
# local AIOps demo. The local base Compose file pins Argus-owned service names
# in SSRF_ALLOWLIST_HOSTS; deployments outside Compose must allow their exact
# internal provider DNS names explicitly.
# Optional Pack-side bearer token file. If set, add the matching
# argus.aiops entry to ARGUS_SOLUTION_PACK_TOKEN_FILES above.
# ARGUS_AIOPS_DISCOVERY_TOKEN_FILE=
# Local-only inline option. Production should mount a secret file as described
# in docs/ARGUS_CORE_AND_SOLUTION_PACKS.md.
# ARGUS_EXECUTION_GRANT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# OIDC_DEFAULT_ROLE=viewer
# OIDC_EMERGENCY_LOCAL_ADMIN=true
# OIDC_DISABLE_LOCAL_LOGIN=false

# Lokale Passwort-Anmeldung global (unabhaengig von Entra)
LOCAL_AUTH_ENABLED=true

# ── Entra ID Agent Identity (mig 081) ────────────────────────────────────────────
# Per-agent Service Principal provisioning from Blueprint templates.
# Production-grade feature, default off. Set to true ONLY when you have an Entra App
# Registration with Application.ReadWrite.OwnedBy granted and Entra SDK Sidecar running.
ENTRA_AGENT_REGISTRATION=false
ENTRA_SIDECAR_URL=http://localhost:5000
ENTRA_ENV_SLUG=dev
# JSON map of agent_role -> blueprint-id. Argus-IT configures the Blueprint in Entra.
# Example: {"worker":"argus-test-worker","reviewer":"argus-test-reviewer"}
ENTRA_BLUEPRINTS_JSON={}

# ── OAuth2 API Authentication (optional) ──────────────────────────
# Enables OAuth2 JWT bearer authentication for API access (in addition to API keys).
# Issuer and audience are required; token subjects must map to enabled Argus users.
OAUTH2_ENABLED=false
# OAUTH2_ISSUER=https://your-auth-server.com
# OAUTH2_AUDIENCE=https://argus-mcp-server
# OAUTH2_JWKS_URI=https://your-auth-server.com/.well-known/jwks.json

# ── Notifications (optional) ─────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx
# Email alerts (optional — plain SMTP, no external service needed)
# requires: npm install nodemailer
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=argus-alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Argus Alerts <argus-alerts@example.com>
# ALERT_EMAIL_ADDRESS=it-ops@example.com,maintainer@example.com

# ── Direct LLM Providers ─────────────────────────────────────────────────────
# Default: Agents call OpenAI/Anthropic directly. Model names beginning with
# "claude" route to Anthropic; all other models route to OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#
# Optional local/OpenAI-compatible endpoint:
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPAT_API_KEY=
# ALLOW_EMPTY_OPENAI_COMPAT_API_KEY=true
# LLM_PROVIDER_OVERRIDES={"local-*":"openai-compatible","custom-claude":"anthropic"}
#
# Reusable LLM Credential Profiles are managed in Settings → AI Models. They
# support encrypted inline keys plus Environment/Vault references and can be
# assigned to providers or individual agents without exposing the secret.
# Raw per-agent provider keys are a legacy emergency override and ignored by
# default. Enable this only for backwards compatibility.
# DIRECT_AGENT_API_KEYS=false

# Optional local LiteLLM compatibility gateway. It is not required by Argus
# and starts only through the `llm-gateway` Compose profile.
# Never commit a real provider key. Put it in the local .env or a secret file.
LITELLM_PORT=4000
LITELLM_UPSTREAM_MODEL=openai/gpt-5.6-terra
LITELLM_OPENAI_API_KEY=
# Required only for the LiteLLM Admin UI. Generate unique values locally;
# never reuse these examples in a shared environment.
LITELLM_MASTER_KEY=
# Runtime credential used by Argus Core. The local bootstrap creates this as
# a scoped LiteLLM Virtual Key; do not set it to the Proxy master key.
ARGUS_LITELLM_API_KEY=

# Optional Argus.Dev E2E lab (`scripts/bootstrap-dev-demo.ps1`). Secrets are
# generated into the ignored .env file; never commit populated values.
GITEA_PORT=3005
GITEA_USERNAME=argus
GITEA_PASSWORD=
GITEA_TOKEN=
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_BASE_URL=http://gitea:3000
GITEA_PUBLIC_URL=http://127.0.0.1:3005
GITEA_OWNER=argus
GITEA_REPO=argus-dev-sample
ARGUS_DEV_DEMO_USER=Alex

# Golden Path target identity. These values are not credentials. The defaults
# describe the disposable local certification fixture; a live GitHub/Slack
# demo must override every target explicitly and keep tokens in MCP Fabric.
ARGUS_GOLDEN_PATH_WORKSPACE_KEY=default
ARGUS_GOLDEN_PATH_TENANT_KEY=default
ARGUS_GOLDEN_PATH_ENVIRONMENT=demo
ARGUS_GOLDEN_PATH_WORKFLOW_NAME=golden_path_dev_triage
ARGUS_GOLDEN_PATH_AGENT_NAME=planner
ARGUS_GOLDEN_PATH_PREFERRED_RUNTIME=hermes
ARGUS_GOLDEN_PATH_RUNTIME_FALLBACK=true
ARGUS_GOLDEN_PATH_GIT_BUNDLE=gitea_local
ARGUS_GOLDEN_PATH_GIT_REPOSITORY=argus/golden-path-demo
ARGUS_GOLDEN_PATH_ISSUE_NUMBER=17
ARGUS_GOLDEN_PATH_GIT_ORIGIN=http://gitea:3000
ARGUS_GOLDEN_PATH_NOTIFICATION_BUNDLE=slack_fixture
ARGUS_GOLDEN_PATH_NOTIFICATION_DESTINATION=argus-golden-path
# Optional additional exact hostnames. The local Compose stack already permits
# its Argus-owned service DNS names; keep custom additions narrow because this
# list is the explicit exception to Argus's private-address SSRF guard.
# SSRF_ALLOWLIST_HOSTS=internal-observability.example
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
LITELLM_DATABASE_PASSWORD=

# Optional zero-API-cost local model runtime. Start with both profiles:
# docker compose --profile llm-gateway --profile local-llm up -d ollama litellm
OLLAMA_PORT=11434
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_MODEL=granite3.3:2b
LITELLM_OLLAMA_MODEL=ollama_chat/granite3.3:2b
LITELLM_OLLAMA_CODER_MODEL=ollama_chat/qwen2.5-coder:3b
LITELLM_OLLAMA_EMBEDDING_MODEL=ollama/qwen3-embedding:0.6b
# Windows AMD hosts should run Ollama natively and set:
# OLLAMA_API_BASE=http://host.docker.internal:11434
# Create a local alias with a 16K context window (the Windows bootstrap does
# this automatically), then route both stable LiteLLM aliases through it:
# OLLAMA_MODEL=argus-qwen3.5:9b
# LITELLM_OLLAMA_MODEL=ollama_chat/argus-qwen3.5:9b
# Prefer the general Qwen 3.5 model for agentic tool-calling; the older
# qwen2.5-coder models often emit prose diffs instead of native tool calls.
# LITELLM_OLLAMA_CODER_MODEL=ollama_chat/argus-qwen3.5:9b
# LITELLM_OLLAMA_EMBEDDING_MODEL=ollama/qwen3-embedding:0.6b
# Local CPU inference can require more than Core's 120-second production
# default. Raise this only for slow self-hosted models.
# LLM_REQUEST_TIMEOUT_MS=300000

# Fresh installations start without fixed agents or models. Starter roles stay
# available as provider-neutral blueprints in Agent Studio and require an
# explicit catalog model during installation. Compatibility opt-in only:
# ARGUS_INSTALL_STARTER_AGENTS=false

# Embedding model for pgvector Knowledge + Agent Memory. The local bootstrap
# routes this stable alias through LiteLLM to native/containerized Ollama.
EMBEDDING_MODEL=argus-local-embedding
# Automatic retrieval and post-turn extraction need a separate embedding
# provider. Keep disabled for direct/Codex/Claude subscription runtimes unless
# that provider is configured intentionally. The Everything installer enables
# it for the bundled local embedding runtime.
ARGUS_AGENT_MEMORY_AUTO_ENABLED=false
# Native code vectors are opt-in for cost control. The local bootstrap enables
# them because argus-local-embedding is self-hosted through LiteLLM.
ARGUS_CODE_EMBEDDINGS_ENABLED=false

# Bounded, bundle-authorized immutable repository graph API (prototype rollout)
ARGUS_REPOSITORY_GRAPH_ENABLED=false
# Permission-gated canonical business-audit evidence query API (prototype rollout)
ARGUS_AUDIT_EVIDENCE_V1_ENABLED=false
# Optional Ed25519 checkpoint signer. Prefer a read-only secret file; never
# commit the private key. Container deployments must mount the file themselves.
# ARGUS_AUDIT_SIGNING_KEY_ID=audit-prod-2026-q3
# ARGUS_AUDIT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/argus-audit-signing-key
# Inline PEM exists only for secret-manager injection where a file is impossible:
# ARGUS_AUDIT_SIGNING_PRIVATE_KEY=
# Verification/checkpoint cadence and canonical outbox-lag alert threshold.
ARGUS_AUDIT_CHECKPOINT_INTERVAL_SEC=300
ARGUS_AUDIT_REPORT_WORKER_INTERVAL_SEC=60
ARGUS_AUDIT_OUTBOX_LAG_ALERT_SEC=300
# Automatically verify applied MCP Fabric Bundle Sets. Notifications use the
# existing Slack, Teams or SMTP channels and fire only on state transitions.
ARGUS_MCP_FABRIC_DRIFT_INTERVAL_SEC=300
# Local single-admin UI demos only; never enable for a production tenant.
ALLOW_SELF_APPROVE_FABRIC_RESTORE=false
ARGUS_CODE_EMBEDDING_MODEL=argus-local-embedding
ARGUS_CODE_EMBEDDING_PROFILE=qwen3-code-retrieval
ARGUS_CODE_EMBEDDING_BATCH_SIZE=16
ARGUS_CODE_EMBEDDING_MAX_DOCUMENTS=20000
ARGUS_CODE_EMBEDDING_MAX_INPUT_BYTES=24000
ARGUS_CODE_EMBEDDING_TIMEOUT_MS=120000

# Model for background consolidation of agent memories (6-hour job)
MEMORY_CONSOLIDATION_MODEL=gpt-4o-mini

# ── Langfuse (LLM Observability) ─────────────────────────────────────────────
# Keys from Langfuse UI -> Settings -> API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# Note: Langfuse usually runs from a separate compose file
# with its own network, so mcp-server can NOT resolve "langfuse:3100".
# Local development (separate compose files): http://host.docker.internal:3100
# Shared network (same Docker network, Kubernetes): http://langfuse:3100
# LANGFUSE_HOST=http://host.docker.internal:3100

# ── Langfuse Alert Dispatcher ────────────────────────────────────────────────
# Polls Langfuse every 5 min for ERROR traces and sub-threshold scores,
# fans out to a Slack/Teams/Discord webhook. Disabled when ALERTS_WEBHOOK_URL
# is empty.
# ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERTS_WEBHOOK_FORMAT=slack          # slack | teams | generic
# ALERTS_POLL_INTERVAL_MS=300000        # 5 min
# ALERTS_LOOKBACK_MS=600000             # 10 min
# ALERTS_COMPLIANCE_THRESHOLD=70        # compliance_score < this → warn
# ALERTS_QUALITY_THRESHOLD=0.7          # eval_overall < this → warn

# ── Synthetic Canaries ────────────────────────────────────────────────────────
# Periodic health-pings against each enabled chat-mode agent. De-flaked:
# alerts on 1st failure + every 3rd consecutive failure, plus recovery alert.
# CANARIES_ENABLED=1
# CANARIES_INTERVAL_MS=300000           # 5 min
# CANARIES_TIMEOUT_MS=30000             # per-canary HTTP timeout
# CANARIES_RETENTION_DAYS=30             # persisted run evidence, 1-90 days
# CANARIES_AGENT_IDS=5,4                # comma-separated; empty = all enabled chat agents
# CANARIES_API_KEY=test-api-key-12345678   # falls back to first MCP_API_KEYS entry
# CANARIES_BASE_URL=http://localhost:3000

# ── Optional live CI provider canaries (read-only) ──────────────────────────
# Disabled by default. Targets are JSON and reference token environment names;
# raw provider credentials are never persisted or included in evidence.
# ARGUS_CI_CANARIES_ENABLED=0
# ARGUS_CI_CANARIES_MIN_INTERVAL_MS=900000  # max one probe batch / 15 min
# ARGUS_CI_CANARIES_TIMEOUT_MS=15000
# ARGUS_CI_CANARY_TARGETS=[{"provider":"github","base_url":"https://api.github.com","owner":"org","repo":"repo","run_id":"123","token_env":"GITHUB_CI_TOKEN"}]
# For local Gitea, use the same provider token reference without putting the
# secret into JSON: {"provider":"gitea","base_url":"http://gitea:3000","owner":"argus","repo":"argus-dev-sample","run_id":"123","token_env":"GITEA_TOKEN"}
# ARGUS_CI_CANARIES_SCHEDULED=0             # Core scheduler; 1 enables an opt-in daily rollout
# ARGUS_CI_CANARIES_SCHEDULE_INTERVAL_MS=86400000
# ARGUS_CI_CANARIES_REQUIRED_PROVIDERS=gitea,github  # release gate coverage; empty = optional
# ARGUS_PROVIDER_CERTIFICATION_REPORT=test-results/ci-provider-certification.json

# ── Release certification manifest (HMAC signed) ───────────────────────────
# ARGUS_CERTIFICATION_SIGNING_KEY=change-me-in-ci-secret-store
# ARGUS_CERTIFICATION_REQUIRED_GATES=ci-provider
# ARGUS_CERTIFICATION_REQUIRE_IMAGE_DIGEST=1
# ARGUS_IMAGE_REFERENCE=ghcr.io/example/argus-core
# ARGUS_IMAGE_DIGEST=sha256:...
# ARGUS_CERTIFICATION_MANIFEST_PATH=test-results/argus-certification-manifest.json
# MIGRATION_CERTIFICATION_DATABASE_URL=postgresql://user:password@disposable-host/argus_upgrade_test
# MIGRATION_CERTIFICATION_REQUIRED=1
# ARGUS_MIGRATION_CERTIFICATION_REPORT=test-results/migration-certification.json
# AI_SYSTEM_GOVERNANCE_CERTIFICATION_DATABASE_URL=postgresql://user:password@disposable-host/argus_ai_governance_test
# AI_SYSTEM_GOVERNANCE_CERTIFICATION_REQUIRED=1
# AI_SYSTEM_GOVERNANCE_CERTIFICATION_REPORT=test-results/ai-system-governance-certification.json
# ARGUS_CHAOS_HEALTH_URLS=http://127.0.0.1:3000/health,http://127.0.0.1:3101/health
# ARGUS_CHAOS_RESTART_COMMAND_JSON=["docker","compose","restart","mcp-server"]
# ARGUS_CHAOS_RECOVERY_TIMEOUT_MS=90000
# ARGUS_CHAOS_REQUIRED=1
# ARGUS_CHAOS_REPORT=test-results/chaos-recovery.json
# ── Multi-replica session continuity (HA Compose overlay) ──────────────────
# ARGUS_HA_PRIMARY_URL=http://127.0.0.1:3111
# ARGUS_HA_SECONDARY_URL=http://127.0.0.1:3112
# ARGUS_HA_RESTART_COMMAND_JSON=["docker","compose","-p","argus-ha","-f","compose.e2e.yml","-f","compose.ha.e2e.yml","restart","argus-a"]
# ARGUS_HA_REQUIRED=1
# ARGUS_HA_REPORT=test-results/ha-session-continuity.json
# ── Deterministic LLM provider fault matrix ─────────────────────────────────
# ARGUS_LLM_FAULT_BASE_URL=http://127.0.0.1:4000/v1
# ARGUS_LLM_FAULT_TIMEOUT_MS=750
# ARGUS_LLM_FAULT_REQUIRED=1
# ARGUS_LLM_FAULT_REPORT=test-results/llm-provider-faults.json

# ── Redis (Caching, Rate Limiting) ───────────────────────────────────────────
# Set to true when the Redis container is running (included in docker-compose)
REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=

# Agent Workspace Container URL (isolierte Code-Execution-Umgebung)
AGENT_WORKSPACE_URL=http://agent-workspace:3001
# The Argus.Dev workspace can include Go, Rust, Java/Gradle/Maven and .NET in
# addition to its default Node/Python tooling. Core-only startup never builds
# this image. Disable only when a lightweight Node/Python workspace is enough.
ARGUS_DEV_MULTILANG=true
AGENT_WORKSPACE_NPM_LEGACY_PEER_DEPS=true
AGENT_WORKSPACE_MEMORY_LIMIT=4G
AGENT_WORKSPACE_CPU_LIMIT=2.0
# Operator-only limits for isolated experiment/QA source snapshots (integer MiB).
# Per-file 1-32, total 1-256, file <= total. No agent/request overrides.
ARGUS_SNAPSHOT_FILE_MIB=16
ARGUS_SNAPSHOT_TOTAL_MIB=128

# Project test environments: explicit candidate opt-in in Core, Dev and Workspace.
# Fresh runs only; independent Python QA only, not arbitrary install commands.
# General opt-in: compose.dev-project-environments-pilot.yml (isolated PyPI broker).
# Static legacy mode requires reviewed read-only catalog/wheel mounts.
ARGUS_PROJECT_ENVIRONMENTS_ENABLED=false
# Workspace-only mode; the pilot overlay sets this explicitly.
ARGUS_PROJECT_ENVIRONMENTS_MODE=static-catalog-v1
# Policy 2: agent-planned disposable Linux stacks, only for NEW QA-enabled runs.
# Requires separately certified controller/egress/base images and the general-stack overlay.
ARGUS_GENERAL_STACKS_ENABLED=false
# ARGUS_STACK_BASE_IMAGE=sha256:<immutable locally built image ID>
# ARGUS_STACK_RUNNER_SECRET_FILE=/absolute/path/to/dedicated-secret-file
# ARGUS_ENVIRONMENT_RESOLVER_SECRET_FILE=/absolute/path/to/secret-file (never a value)
AGENT_WORKSPACE_DATABASE_URL=postgresql://postgres@agent-workspace-db:5432/app
AGENT_WORKSPACE_FASTAPI_ENV=development

# Official Codex runtime for Argus.Dev. The endpoint is available by default,
# but it is used only after an administrator signs in and explicitly assigns
# its runtime profile to an Agent. Credentials stay separate from LiteLLM and
# general model routing. Connect it in Settings -> Providers & Models.
ARGUS_CODEX_ENABLED=true
ARGUS_DEV_CODER_RUNTIME=argus
# Leave empty to use the Codex account's recommended default model.
# Backward-compatible fallback for older Solution Packs. Current packs read
# model and reasoning policy from the Agent runtime profile in Argus Core.
ARGUS_CODEX_MODEL=gpt-5.6-terra
ARGUS_CODEX_REASONING_EFFORT=xhigh
ARGUS_CODEX_TIMEOUT_SEC=900
ARGUS_CODEX_MAX_CONCURRENT_RUNS=2
# Core compacts large MCP catalogs and accumulated tool output below the
# workspace bridge's 160k hard boundary. Keep headroom for control framing.
CODEX_CONTEXT_TARGET_CHARS=145000

# Official Claude Code runtime. The endpoint is available by default, but it
# runs only after an administrator signs in and assigns its runtime profile.
# Its Claude.ai Pro/Max OAuth session stays in the separate claude-auth Docker
# volume and is not routed through LiteLLM. Connect it in the Argus UI.
ARGUS_CLAUDE_ENABLED=true
ARGUS_CLAUDE_MAX_CONCURRENT_RUNS=1
ARGUS_CLAUDE_MAX_TURNS=25
# Optional: leave empty to let Claude Code choose the best model for the subscription.
ARGUS_CLAUDE_MODEL=
ARGUS_CLAUDE_TIMEOUT_SEC=900
ARGUS_CLAUDE_PERMISSION_MODE=acceptEdits
ARGUS_CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash
ARGUS_CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=false

# Shared secret between mcp-server and agent-workspace
# Generate with: openssl rand -hex 32
WORKSPACE_SECRET=CHANGE_ME_WORKSPACE_SECRET
ARGUS_EXECUTION_GRANT_SECRET=CHANGE_ME_EXECUTION_GRANT_SECRET

# ── Workflow-Webhook-Trigger HMAC-Secret ─────────────────────────────────────
# Shared secret for POST /webhooks/wf/:slug (HMAC-SHA256 over the raw body,
# header X-Argus-Signature: sha256=<hex>). REQUIRED in production — without it
# the endpoint answers 503 (fail-closed). In development (NODE_ENV!=production)
# it falls back to open with a warning. Generate with: openssl rand -hex 32
# ARGUS_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
GITEA_CI_WEBHOOK_SECRET=
# Provider-owned CI evidence webhooks (all mounted below /api/coding):
# GitHub: HMAC-SHA256 in x-hub-signature-256, event workflow_run
GITHUB_CI_WEBHOOK_SECRET=
# GitLab: Secret Token in x-gitlab-token, event Pipeline Hook
GITLAB_CI_WEBHOOK_SECRET=
# Jenkins: shared token in x-jenkins-token (configure the same value in the hook)
JENKINS_CI_WEBHOOK_SECRET=
# Optional API bases/tokens used when CI provider and Git backend are separate:
# GITHUB_CI_API_BASE_URL=https://api.github.com
# GITLAB_CI_BASE_URL=https://gitlab.example
# JENKINS_CI_BASE_URL=https://jenkins.example/job/example/123
# GITHUB_CI_TOKEN=
# GITLAB_CI_TOKEN=
# JENKINS_CI_TOKEN=
#
# Per-workflow secret (optional): a workflow can name its OWN
# secret environment variable via trigger_config.webhook_secret_env (e.g.
# "WF_DEPLOY_WEBHOOK_SECRET"). Then ONLY that secret is accepted for the slug
# — knowing the global secret is no longer enough to trigger this workflow.
# Without webhook_secret_env, ARGUS_WEBHOOK_SECRET applies.
# Add the named secret as an extra environment variable (e.g. a SealedSecret):
# WF_DEPLOY_WEBHOOK_SECRET=CHANGE_ME_PER_WORKFLOW_SECRET

# ── RAG Reranker (optional) ──────────────────────────────────────
# Re-ranks the top vector-search candidates with a cross-encoder.
# Values: none (default), tei (self-hosted, recommended), cohere, voyage
RAG_RERANKER_PROVIDER=none
RAG_SEARCH_TIMEOUT_MS=30000

# Self-hosted TEI (HuggingFace Text Embeddings Inference)
# Default-Modell: BAAI/bge-reranker-v2-m3 (multilingual incl. DE)
# TEI_RERANKER_URL=http://tei-reranker
# TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # falls anderes Modell gewuenscht

# Cloud-Provider (Alternative)
# COHERE_API_KEY=...
# VOYAGE_API_KEY=...
# RAG_RERANKER_COHERE_MODEL=rerank-multilingual-v3.0
# RAG_RERANKER_VOYAGE_MODEL=rerank-2
# External Qdrant Knowledge source (optional; pgvector remains the built-in default)
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ── Bitbucket (optional, for coding workflow pushes) ─────────────
# Only needed when the coding workflow should push branches to Bitbucket.
# Bitbucket → Profile → HTTP access tokens → Repository write.
# BITBUCKET_TOKEN=BBDC-...
# BITBUCKET_BASE_URL=https://bitbucket.example.com
#
# For pull-request creation in the finalize node — either PROJECT_KEY (project repos)
# OR USER_SLUG (user repos), plus REPO_SLUG.
# BITBUCKET_PROJECT_KEY=PROJ           # Project-Repo: /scm/PROJ/repo.git
# BITBUCKET_USER_SLUG=developer        # User-Repo:    /scm/~developer/repo.git
# BITBUCKET_REPO_SLUG=agent-test
# BITBUCKET_TARGET_BRANCH=master       # PR target (Default: master)

# ── Gitea (optional, for coding workflow pushes) ─────────────────
# Alternative to Bitbucket when you use Gitea.
# GITEA_TOKEN=...
# GITEA_BASE_URL=https://gitea.example.com

# ── n8n Integration (Jira-enriched Coding Workflow Trigger) ──────
# When set, the Argus UI shows only a ticket-ID field.
# Argus calls this n8n webhook, n8n fetches the Jira details
# and calls /api/coding/start back with the full description.
# Build the n8n workflow that receives this webhook in your own n8n instance.
# N8N_CODING_WEBHOOK_URL=http://localhost:5678/webhook/argus-coding-trigger

# Redis cache auth — leave empty to disable auth (dev), set in production
# REDIS_PASSWORD=changeme

# == Security Hardening (Phase 0/1, 2026-06) ==
# Positive egress allowlist for outbound HTTP tools. Empty = disabled (allow all).
# Comma-separated hosts; a host matches exactly or as a subdomain.
# ARGUS_EGRESS_ALLOWLIST=api.github.com,registry.npmjs.org
#
# SSRF exception list: cluster-internal service DNS names that legitimately
# resolve to private IPs (hostname match only, no IP match). Required if internal
# backends/webhooks must pass the DNS-rebinding SSRF guard.
# SSRF_ALLOWLIST_HOSTS=argus-develop-langgraph,argus-develop-langfuse-web
#
# Enforce Argus tool RBAC (default true). Set false only for local dev.
# ARGUS_RBAC_ENFORCE=true
#
# Require human approval before prod-cluster ops (default false; true for prod).
# ARGUS_PROD_APPROVAL_ENFORCE=false
#
# Wall-clock cap per agent session in seconds (default 600).
# MAX_AGENT_SESSION_SECONDS=600
#
# == ML-PII detection (P2.1, OPT-IN — needs the `pii` docker-compose profile) ==
# NER-based PII detection (self-hosted Presidio) on top of the regex pii-pre-write
# floor. Start Presidio: docker compose --profile pii up -d presidio-analyzer
# The hook degrades gracefully (regex-only) if Presidio is off/unreachable.
# PII_ML_ENABLED=false
# PII_ML_URL=http://presidio-analyzer:3000
# PII_ML_THRESHOLD=0.6
# Comma-separated Presidio entity types to flag; empty = any type >= threshold.
# PII_ML_ENTITIES=PERSON,EMAIL_ADDRESS,CREDIT_CARD,IBAN_CODE,PHONE_NUMBER,IP_ADDRESS,LOCATION
# PII_ML_LANGUAGE=en

# ── Chat SPA ─────────────────────────────────────────────────────────────────
# Serve the new React chat SPA at /chat (coexistence flag; ?classic=1 forces the old chat). Default off.
CHAT_SPA_ENABLED=false

# ── AI interaction transparency ───────────────────────────────────────────────
# Displayed on interactive Agent Chat surfaces by default. Keep enabled unless a
# documented use-case assessment confirms that another compliant notice exists.
AI_TRANSPARENCY_NOTICE_ENABLED=true

# ── AI-system production release gate ────────────────────────────────────────
# A workflow is gated only after an administrator explicitly binds it to an
# immutable AI-system revision. Builder and local webhook tests stay sandboxed.
# Cron and externally delivered webhooks for a governed workflow fail closed
# until that exact revision is released and the service identity is verified.
ARGUS_ENVIRONMENT=local
ARGUS_AI_ACT_WORKLOAD_IDENTITY_SUBJECT=workload:argus-core:workflow-trigger
ARGUS_AI_ACT_WORKLOAD_IDENTITY_VERIFIED=false
# Set the verification flag true only when the runtime is actually protected by
# your Kubernetes/cloud workload-identity boundary. An API key is not equivalent.

# ── External Evidence Pack anchoring ─────────────────────────────────────────
# Optional signed-JSON gateway to a customer-owned WORM object store, RFC 3161
# timestamp service or transparency log. The gateway receipt must be Ed25519
# signed and bind the exact Evidence Pack or retention-archive UUID + SHA-256 +
# workspace/tenant/environment scope. Retention-archive requests additionally
# carry the complete canonical JSON package that the gateway must store under
# an enforced immutable retention lock. The same endpoint may also handle
# argus.external-retention-archive-retrieve-request for independent full-object
# restore drills. Disabled or a provider without retrieval is fail-visible.
ARGUS_EXTERNAL_ANCHOR_ENABLED=false
# ARGUS_EXTERNAL_ANCHOR_URL=https://evidence-anchor.example.com/v1/anchors
# ARGUS_EXTERNAL_ANCHOR_PROVIDER=customer-evidence-vault
# ARGUS_EXTERNAL_ANCHOR_KEY_ID=customer-anchor-ed25519-v1
# ARGUS_EXTERNAL_ANCHOR_PUBLIC_KEY_FILE=/run/secrets/argus-external-anchor-public-key
# ARGUS_EXTERNAL_ANCHOR_TOKEN_FILE=/run/secrets/argus-external-anchor-token
# ARGUS_EXTERNAL_ANCHOR_KINDS=worm_object,qualified_timestamp,transparency_log
# ARGUS_EXTERNAL_ANCHOR_TIMEOUT_MS=10000
# Local development only; production endpoints must use HTTPS.
# ARGUS_EXTERNAL_ANCHOR_ALLOW_LOCAL_HTTP=false
# Exact Compose/DNS hostnames additionally allowed with the local HTTP opt-in.
# Never use suffixes or wildcards; production gateways should use HTTPS.
# ARGUS_EXTERNAL_ANCHOR_HTTP_HOSTS=worm-gateway

# ── Public agent widgets (anonymous, fail-closed by default) ─────────────────
# Enable only after at least one public Agent and an exact Allowed Origin have
# been configured under /build/public-widgets.
PUBLIC_WIDGET_ENABLED=false
# Production: set a dedicated high-entropy value instead of relying on the
# development derivation from SESSION_SECRET.
# WIDGET_TOKEN_SECRET=
WIDGET_TOKEN_TTL_SEC=1800
TURNSTILE_ENABLED=false
# TURNSTILE_SECRET=

# ── Deterministic provider-fault certification (opt-in, local only) ─────────
# The HA E2E overlay exposes fake-openai on 4000 and fake-anthropic on 4100.
# Set REQUIRED=1 in CI when the corresponding fixture must be reachable.
# ARGUS_LLM_FAULT_BASE_URL=http://127.0.0.1:4000/v1
# ARGUS_LLM_FAULT_REQUIRED=1
# ARGUS_LLM_FAULT_TIMEOUT_MS=750
# ARGUS_ANTHROPIC_FAULT_BASE_URL=http://127.0.0.1:4100/v1
# ARGUS_ANTHROPIC_FAULT_REQUIRED=1
# ARGUS_ANTHROPIC_FAULT_TIMEOUT_MS=750
# ARGUS_ANTHROPIC_FAULT_HOST_PORT=4100
# ARGUS_QDRANT_CERTIFICATION_BASE_URL=http://127.0.0.1:16333
# ARGUS_QDRANT_CERTIFICATION_REQUIRED=1
# ARGUS_QDRANT_CERTIFICATION_TIMEOUT_MS=2000
# ARGUS_QDRANT_PORT=16333
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=250
# LLM_RETRY_MAX_MS=4000
# AI_TRANSPARENCY_NOTICE_TEXT=You are interacting with an AI agent. Responses may be inaccurate; verify important information and review tool actions before approval.
