{
  "name": "argus-dev",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Argus Dev solution pack: governed LangGraph development workflows",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:contracts": "node scripts/check-core-contracts.mjs",
    "certify:cancellation": "npm run build && node scripts/certify-cancellation.mjs",
    "certify:checkpoint-retry": "npm run build && node scripts/certify-checkpoint-retry.mjs",
    "certify:stack-recovery": "npm run build && node scripts/certify-stack-recovery.mjs",
    "certify:technical-design": "npm run build && node scripts/certify-technical-design.mjs",
    "certify:qa-acceptance": "npm run build && node scripts/certify-qa-acceptance.mjs",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "pg": "^8.20.0",
    "undici": "^7.24.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
