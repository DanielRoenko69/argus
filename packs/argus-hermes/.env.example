# Public endpoint of this Pack. Core normally reaches the internal Compose/Kubernetes service address.
PORT=2040
ARGUS_HERMES_PUBLIC_URL=http://localhost:2040

# Required for every Pack route except the unauthenticated /healthz liveness
# check. Local development may use the inline value; production must mount a
# readable secret file into the Pack and Argus Core.
# Production deployments should prefer ARGUS_PACK_DISCOVERY_TOKEN_FILE.
ARGUS_PACK_DISCOVERY_TOKEN=
ARGUS_PACK_DISCOVERY_TOKEN_FILE=

# Not used to launch a runner in v0.1.0. It becomes mandatory before a managed
# Hermes provisioner may start: lease endpoints must use exactly this origin
# plus /mcp/runtime/<leaseId>. Use the internal Core service address, never a
# browser-facing URL or a URL with a path.
ARGUS_CORE_RUNTIME_MCP_ORIGIN=

# Optional isolated runner broker. Configure all of these only after deploying
# a separately privileged runnerd service. The Pack itself never mounts the
# Docker socket; runnerd owns the pinned image, per-run network and proxy.
# Production must prefer ARGUS_HERMES_RUNNERD_TOKEN_FILE over the inline token.
ARGUS_HERMES_RUNNERD_URL=
ARGUS_HERMES_RUNNERD_TOKEN=
ARGUS_HERMES_RUNNERD_TOKEN_FILE=
ARGUS_HERMES_MANAGED_STATE_DIRECTORY=/var/lib/argus-hermes
ARGUS_HERMES_RUNNERD_POLL_MS=1000

# runnerd is a distinct, separately privileged process with its own service
# environment and state volume. The starter intentionally has no launcher,
# so its authenticated GET /v1/ready returns 503 until a reviewed launcher is
# injected. Do not add a Docker socket to the Pack in order to change that.
ARGUS_HERMES_RUNNERD_PORT=2042
ARGUS_HERMES_RUNNERD_STATE_DIRECTORY=/var/lib/argus-hermes-runnerd

# An existing Hermes API server can be attached without giving Argus a shell,
# browser or profile on the remote host. Keep the API key out of source control;
# production deployments should prefer HERMES_API_KEY_FILE.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_API_KEY_FILE=
HERMES_REQUEST_TIMEOUT_MS=5000
