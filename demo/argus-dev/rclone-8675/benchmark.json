  "ticket": {
    "id": "RCLONE-8675",
    "description": "Make bisync safe when multiple asynchronous RC jobs run concurrently in the same process. Mutable state belonging to one bisync invocation must not be shared with or reset underneath another invocation. Cover listing, comparison, marching, queueing, logging, conflict resolution and cleanup paths; preserve existing CLI and single-run behavior; add a race-detector regression test; run the focused bisync suite with -race; and stop at governed human approval before any branch push or pull request."
  },
  "expectedChangeSurface": {
    "areas": [
      "cmd/bisync"
    ],
    "forbidden": [
      "a package-wide mutex around the complete bisync operation",
      "disabling asynchronous RC execution",
      "removing race-detector coverage",
      "skipping existing bisync scenarios"
    ]
  },
