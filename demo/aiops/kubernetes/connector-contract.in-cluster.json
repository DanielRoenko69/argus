{
  "$schema": "./connector-contract.schema.json",
  "apiVersion": "connectors.argus.eu/v1alpha1",
  "kind": "KubernetesConnectorCertification",
  "metadata": {
    "name": "argus-aiops-kind-in-cluster",
    "targetId": "argus-aiops-kind"
  },
  "spec": {
    "profile": "in-cluster-read-only",
    "platform": "kubernetes",
    "context": "kind-argus-aiops",
    "namespace": "argus-aiops-system",
    "workload": {
      "deployment": "argus-kubernetes-connector",
      "service": "argus-kubernetes-connector",
      "serviceAccount": "argus-kubernetes-connector",
      "container": "tools",
      "selector": {
        "app.kubernetes.io/instance": "argus-kubernetes-connector",
        "app.kubernetes.io/name": "argus-kubernetes-connector"
      },
      "expectedImageDigest": "sha256:50b431281d3e32666f27a292962fd486aabaac157083a844d037c12137e353aa"
    },
    "endpoint": {
      "scheme": "http",
      "host": "argus-kubernetes-connector.argus-aiops-system.svc.cluster.local",
      "port": 8084,
      "path": "/mcp",
      "serviceType": "ClusterIP"
    },
    "scope": {
      "readNamespaces": ["argus-aiops-system", "argus-demo"],
      "executionNamespaces": ["argus-demo"],
      "readOnly": true,
      "allowSecrets": false
    },
    "identity": {
      "kubernetes": {
        "mode": "projected-service-account-token",
        "maxTokenLifetimeSeconds": 7200
      },
      "cloud": {
        "mode": "none"
      }
    },
    "security": {
      "requireRestrictedIngress": true,
      "requireNetworkPolicyEnforcement": true,
      "networkPolicyProbe": {
        "image": "docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10",
        "healthPath": "/health",
        "timeoutSeconds": 5,
        "stabilizationSeconds": 4
      },
      "requireNonRoot": true,
      "requireReadOnlyRootFilesystem": true,
      "requireSeccompRuntimeDefault": true,
      "requireDropAllCapabilities": true,
      "requireReadinessProbe": true,
      "forbidClusterRoleBinding": true,
      "forbidLegacyServiceAccountToken": true
    },
    "permissionAssertions": [
      { "verb": "get", "resource": "pods", "namespace": "argus-demo", "allowed": true },
      { "verb": "get", "resource": "pods/log", "namespace": "argus-demo", "allowed": true },
      { "verb": "delete", "resource": "pods", "namespace": "argus-demo", "allowed": false },
      { "verb": "get", "resource": "secrets", "namespace": "argus-demo", "allowed": false },
      { "verb": "get", "resource": "pods", "namespace": "kube-system", "allowed": false }
    ]
  }
}
